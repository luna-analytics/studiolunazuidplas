{
  "version": 2,
  "regions": ["fra1"],
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/studio-luna run build",
  "outputDirectory": "artifacts/studio-luna/dist/public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "studiolunazuidplas.nl" }],
      "destination": "https://www.studiolunazuidplas.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "moederschapsgids.nl" }],
      "destination": "https://www.studiolunazuidplas.nl/geboortezorg-zuidplas",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.moederschapsgids.nl" }],
      "destination": "https://www.studiolunazuidplas.nl/geboortezorg-zuidplas",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "moederschapswijzer.nl" }],
      "destination": "https://www.studiolunazuidplas.nl/geboortezorg-zuidplas",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.moederschapswijzer.nl" }],
      "destination": "https://www.studiolunazuidplas.nl/geboortezorg-zuidplas",
      "permanent": false
    },
    {
      "source": "/zorgkaart",
      "destination": "/geboortezorg-zuidplas",
      "permanent": true
    },
    {
      "source": "/zorgkaart-zuidplas",
      "destination": "/geboortezorg-zuidplas",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
