{
  "version": 2,
  "regions": ["fra1"],
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/studio-luna run build",
  "outputDirectory": "artifacts/studio-luna/dist/public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "studiolunazuidplas.nl" }],
      "destination": "https://www.studiolunazuidplas.nl/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
