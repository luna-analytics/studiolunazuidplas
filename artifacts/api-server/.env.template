# Studio Luna — omgevingsvariabelen
# Kopieer dit bestand naar de hoofdmap van de repo als `.env` en vul de waarden in.
# Het echte .env-bestand staat in .gitignore en gaat nooit naar GitHub.

# Uit Replit Secrets kopiëren (slotje-icoontje in Replit):
ADMIN_PASSWORD=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Nieuw gegenereerd (het oude stond in de code en is vervangen):
JWT_SECRET=

# Vast:
ADMIN_EMAIL=info@studiolunazuidplas.nl
SITE_URL=https://www.studiolunazuidplas.nl

# Komt uit Neon/Vercel zodra de database bestaat (begint met postgresql://):
DATABASE_URL=
